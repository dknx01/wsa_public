{% extends 'base_admin.html.twig' %}
{% block title %}UU-Dokumente{% endblock %}
{% block pageHeader %}UU-Dokumente{% endblock %}
{% block body %}
        <div class="table-responsive table-responsive-sm">
            <table class="table table-sm table-hover table-striped" data-controller="adminDocuments">
                <thead>
                <tr>
                    <th scope="col">Bundesland</th>
                    <th scope="col">Listen-Typ</th>
                    <th scope="col">WK-Name</th>
                    <th scope="col">Dokumentenname</th>
                </tr>
                </thead>
                <tbody>
                {% for key, document in documents %}
                    <tr>
                        <td data-sort-value="{{ document.state }}"><a href="{{ path('admin_document_edit', {id: document.id}) }}">{{ document.state }}</a></td>
                        <td data-sort-value="{{ document.type }}"><a href="{{ path('admin_document_edit', {id: document.id}) }}">{{ document.type }}</a></td>
                        <td data-sort-value="{{ document.wkName }}"><a href="{{ path('admin_document_edit', {id: document.id}) }}">{{ document.wkName }}</a></td>
                        <td data-sort-value="{{ document.fileName }}"><a href="{{ path('admin_document_edit', {id: document.id}) }}">{{ document.fileName }}</a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
{% endblock %}
