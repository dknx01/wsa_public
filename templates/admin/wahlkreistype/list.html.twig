{% trans_default_domain 'admin' %}
{% extends 'base_admin.html.twig' %}
{% block title %}{{ 'wahlkreistype.title'|trans }}{% endblock %}
{% block pageHeader %}{{ 'wahlkreistype.title'|trans }}{% endblock %}
{% block body %}
    <div class="table-responsive table-responsive-sm">
            <table id="wahlkreistypeTable" class="table table-sm table-hover table-striped" data-controller="admin-wahlkreistypes">
                <thead>
                <tr>
                    <th scope="col">{{ 'wahlkreistype.name'|trans }}</th>
                    <th scope="col">{{ 'wahlkreistype.abbr'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for key, wahlkreistype in wahlkreistypes %}
                    <tr>
                        <td data-sort-value="{{ wahlkreistype.name }}"><a href="{{ path('admin_wahlkreistype_edit', {id: wahlkreistype.id}) }}">{{ wahlkreistype.name }}</a></td>
                        <td data-sort-value="{{ wahlkreistype.abbreviation }}"><a href="{{ path('admin_wahlkreistype_edit', {id: wahlkreistype.id}) }}">{{ wahlkreistype.abbreviation }}</a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
    </div>
{% endblock %}
