{% extends 'base_admin.html.twig' %}
{% block title %}Benutzer{% endblock %}
{% block pageHeader %}Benutzer{% endblock %}

{% block body %}

    {{ include('layout/flash_messages.html.twig') }}
        <table class="table table-striped" id="user_overview" data-controller="adminUser">
            <thead class="thead-light">
            <tr>
                <th scope="col">E-Mail</th>
                <th scope="col">Aktiv</th>
            </tr>
            </thead>
            <tbody>
            {% for key, user in users %}
                <tr>
                    <td><a href="{{ path('user_edit', {id: user.id}) }}">{{ user.email }}</a></td>
                    <td>{{ _self.simple_status(user.active) }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
{% endblock %}

{% macro simple_status(value) %}
    {% if value is true %}
        <span class="badge text-black icon-green"><box-icon type='solid' name='check-circle' animation="tada-hover"></box-icon></span>
    {% else %}
        <span class="badge text-black icon-red"><box-icon type='solid' name='x-circle' animation="tada-hover"></box-icon></span>
    {% endif %}
{% endmacro %}
